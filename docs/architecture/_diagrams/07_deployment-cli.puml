@startuml
!include style.puml
left to right direction

actor "End User" as user

rectangle "Customer Environment" as customer {

    node "Workstation" as workstation {
        node "Java Runtime Environment (JRE)" as jre {
            artifact "**CLI**\n(fat JAR)" as cli
        }
    }
}

user --> cli : uses

@enduml
