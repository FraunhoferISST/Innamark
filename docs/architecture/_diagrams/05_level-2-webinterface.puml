@startuml
!include style.puml
left to right direction

' === System Boundary ===
rectangle "**Web Interface**" <<Application>> as system {
    component "**App**" <<Container>> as app {
        component "**Embed Tab**" <<UI Component>> as embedTab
        component "**Extract Tab**" <<UI Component>> as extractTab
    }
}

component "**Watermarker Library**" <<Library>> as lib

' External
embedTab -(0- lib : JS target
extractTab -(0- lib : JS target

@enduml
