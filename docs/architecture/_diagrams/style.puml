' Shared PlantUML style for all arc42 architecture diagrams.
' Include this fragment inside each diagram's @startuml block with:  !include style.puml
' It must NOT contain @startuml/@enduml so the renderer skips it as a standalone file.
' The include must be inside @startuml so the skinparam directives take effect.

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam roundCorner 10
skinparam shadowing false

<style>
.Innamark {
  BackgroundColor #DDEBFF
  BorderColor #07184E
  FontColor #07184E
}
</style>

left to right direction
