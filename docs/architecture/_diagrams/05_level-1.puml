@startuml
!include style.puml


' === System Boundary ===
rectangle "Innamark" as system {

    ' --- Core Library ---
    component "**Watermarker Library**" <<Library>> as lib

    ' --- Public Tools ---
    component "**CLI**" <<Application>> as cli
    component "**Web Interface**" <<Application>> as webinterface

    ' --- Internal / Commercial ---
    component "**REST API**" <<Closed Source>> as child_api
}

' === Internal: all components build on library ===
cli -0)- lib : JVM target
webinterface -0)- lib : JS target
child_api -0)- lib : JVM target

@enduml
