@startuml
!include style.puml
left to right direction

' === System Boundary ===
rectangle "**CLI**" <<Application>> as system {
    component "**Main**" <<Component>> as app
}

component "**Watermarker Library**" <<Library>> as watermarkerlib
component "**kotlinx-cli**" <<Library>> as clilib

' External
app -(0- watermarkerlib : JVM target
app -(0- clilib

@enduml
