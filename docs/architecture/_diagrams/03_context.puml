@startuml
!include style.puml
left to right direction
hide stereotypes

' == SYSTEMS ==
rectangle "Customer Environment" as company {
    component "Customer Application" as app

    component "**Innamark**" as innamark <<Innamark>>
}

rectangle "Fraunhofer ISST" as isst {
    component "License Server" as parent_api
}

' == ACTORS ==
actor "End User" as user
actor "Developer" as dev

' == CONNECTIONS ==
user .down.> app : uses
app -> innamark : "uses    "
innamark <--> parent_api : communicates (HTTPS)

dev ..> app : develops
dev ..> innamark : integrates
@enduml
